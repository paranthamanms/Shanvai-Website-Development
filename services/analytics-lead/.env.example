NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://shanvai:shanvai@localhost:5433/shanvai

# CORS — Micro-Frontend shell origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# AI provider: "stub" | "openai" | "gemini"
AI_PROVIDER=stub
OPENAI_API_KEY=
GEMINI_API_KEY=

# Enterprise demo notifications (admin inbox)
LEAD_NOTIFY_EMAIL=admin@shanvai.com
SES_FROM_EMAIL=admin@shanvai.com
# Local dev: console logs the email. Production ECS: ses (default).
EMAIL_PROVIDER=console
AWS_REGION=ap-south-1
