aws_region   = "ap-south-1"
aws_profile  = "credit-bureau-dev"
environment  = "prod"
project_name = "shanvai"
domain_name  = "www.shanvai.com"
apex_domain  = "shanvai.com"
vpc_cidr     = "10.50.0.0/16"

# Leave empty on first apply (ECS desired_count=0). After GH Action pushes an image, set e.g.:
# container_image = "<account>.dkr.ecr.ap-south-1.amazonaws.com/shanvai/www:latest"
container_image = ""

desired_count     = 1
task_cpu          = 256
task_memory       = 512
monthly_budget_usd = 50
# budget_email = "you@example.com"

# Enterprise demo form notifications
lead_notify_email = "admin@shanvai.com"
ses_from_email    = "admin@shanvai.com"

github_org    = "paranthamanms"
github_repo   = "Shanvai-Website-Development"
github_branch = "main"
# gh api repos/paranthamanms/Shanvai-Website-Development --jq '{owner_id:.owner.id,id}'
github_owner_id = "9374992"
github_repo_id  = "1307244798"
